<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Jornal.Desktop.ViewModels" xmlns:ui="using:Jornal.Desktop.Controls"
             x:Class="Jornal.Desktop.Controls.OrderEntryControl" x:DataType="vm:OrderEntryField">
  <Grid ColumnDefinitions="144,8,*" RowDefinitions="Auto,Auto,Auto">
    <TextBlock Text="{Binding Label}" Foreground="{DynamicResource JournalMuted}" FontWeight="Medium" FontSize="13"
               VerticalAlignment="Center" TextWrapping="Wrap" />
    <TextBox x:Name="Input" Grid.Column="2" Text="{Binding Value, Mode=TwoWay}"
             IsVisible="{Binding !HasChoices}" MinHeight="36" FontSize="14"
             AutomationProperties.Name="{Binding Label}" Classes.invalid="{Binding HasError}" Classes.needs-review="{Binding NeedsReview}" ToolTip.Tip="{Binding InputHint}">
      <TextBox.InnerRightContent>
        <ui:JournalButton Label="Подтвердить материал" Icon="check" IconOnly="True" Width="28" Height="28" Padding="0" Margin="2,0"
                          IsVisible="{Binding NeedsReview}" Command="{Binding ConfirmReviewCommand}" ToolTip.Tip="Проверьте материал и подтвердите значение" />
      </TextBox.InnerRightContent>
    </TextBox>
    <ComboBox x:Name="Choice" Grid.Column="2" ItemsSource="{Binding Choices}" SelectedItem="{Binding Value, Mode=TwoWay}"
              IsVisible="{Binding HasChoices}" MinHeight="36" FontSize="14" HorizontalAlignment="Stretch"
              ToolTip.Tip="{Binding InputHint}" AutomationProperties.Name="{Binding Label}" />
    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Error}" IsVisible="{Binding HasError}" TextWrapping="Wrap" Margin="0,4,0,0"
               Foreground="{DynamicResource JournalDangerForeground}" FontSize="12" />
    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding ImportHint}" IsVisible="{Binding HasImportHint}" ToolTip.Tip="{Binding ImportEvidence}"
               Classes="muted" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
  </Grid>
</UserControl>
