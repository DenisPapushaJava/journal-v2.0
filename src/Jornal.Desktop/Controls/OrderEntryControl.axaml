<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Jornal.Desktop.ViewModels"
             x:Class="Jornal.Desktop.Controls.OrderEntryControl" x:DataType="vm:OrderEntryField">
  <StackPanel Spacing="8">
    <TextBlock Text="{Binding Label}" Foreground="{DynamicResource JournalMuted}" FontWeight="Medium" />
    <TextBox x:Name="Input" Text="{Binding Value, Mode=TwoWay}" PlaceholderText="{Binding Hint}"
             IsVisible="{Binding !HasChoices}" MinHeight="40" FontSize="14"
             AutomationProperties.Name="{Binding Label}" Classes.invalid="{Binding HasError}" />
    <ComboBox x:Name="Choice" ItemsSource="{Binding Choices}" SelectedItem="{Binding Value, Mode=TwoWay}"
              IsVisible="{Binding HasChoices}" MinHeight="40" FontSize="14" HorizontalAlignment="Stretch"
              PlaceholderText="Выберите вид резки" AutomationProperties.Name="{Binding Label}" />
    <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" TextWrapping="Wrap"
               Foreground="{DynamicResource JournalDangerForeground}" FontSize="12" />
    <TextBlock Text="{Binding ImportHint}" IsVisible="{Binding HasImportHint}" ToolTip.Tip="{Binding ImportEvidence}"
               Classes="muted" FontSize="11" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
