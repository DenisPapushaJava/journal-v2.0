<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Jornal.Desktop.ViewModels" xmlns:ui="using:Jornal.Desktop.Controls"
             x:Class="Jornal.Desktop.Controls.Settings.DiagnosticsPanel" x:DataType="vm:DiagnosticsViewModel">
  <Grid RowDefinitions="Auto,*,Auto">
    <TextBlock Text="Диагностика" FontSize="20" FontWeight="SemiBold" Margin="24,18" />
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24,0" Spacing="12">
      <CheckBox x:Name="AutomaticReportsCheckBox" Content="Автоматически отправлять технические отчёты"
                IsChecked="{Binding SendAutomatically, Mode=TwoWay}" />
      <TextBlock Text="{Binding PrivacyText}" TextWrapping="Wrap" Classes="muted" />
      <TextBlock x:Name="DiagnosticStatus" Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
      <TextBlock x:Name="DiagnosticError" Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource JournalDangerForeground}" />
      <TextBlock Text="{Binding ExportStatus}" TextWrapping="Wrap" />
    </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Background="{DynamicResource JournalSurface}" Padding="24,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
        <ui:JournalButton x:Name="ExportDiagnosticsButton" Label="Сохранить отчёт…" Icon="folder-plus" Click="OnExport" IsEnabled="{Binding !IsExporting}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
