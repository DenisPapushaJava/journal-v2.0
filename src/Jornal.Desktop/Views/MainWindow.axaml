<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Jornal.Desktop.ViewModels"
        xmlns:orders="using:Jornal.Core.Orders"
        xmlns:ui="using:Jornal.Desktop.Controls"
        x:Class="Jornal.Desktop.Views.MainWindow" x:DataType="vm:MainWindowViewModel"
        Title="Journal · Журнал заявок" Width="1366" Height="800" MinWidth="1280" MinHeight="680"
        WindowStartupLocation="CenterScreen">
  <Window.KeyBindings>
    <KeyBinding Gesture="F5" Command="{Binding ReloadCommand}" />
  </Window.KeyBindings>
  <Grid RowDefinitions="52,Auto,Auto,*,32">
    <Border Background="{DynamicResource JournalSurface}" BorderBrush="{DynamicResource JournalBorder}"
            BorderThickness="0,0,0,1" Padding="24,0">
      <Grid ColumnDefinitions="Auto,24,*,Auto,8,Auto,8,Auto,8,Auto">
        <TextBlock Text="Журнал заявок" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
        <TextBlock x:Name="SourceDescriptionText" Grid.Column="2" Text="{Binding SourceDescription}" ToolTip.Tip="{Binding SourceDetails}"
                   Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <Grid Grid.Column="3" VerticalAlignment="Center">
          <ui:JournalButton x:Name="UpdatesButton" Label="{Binding Updates.NotificationText}" Icon="bell" IconOnly="True" Width="32" Height="32" Padding="0"
                            Click="OnUpdatesClick" IsEnabled="{Binding CanCheckUpdates}" ToolTip.Tip="{Binding Updates.NotificationText}" />
          <Ellipse x:Name="UpdateBadge" Width="7" Height="7" Fill="{DynamicResource JournalAccent}" IsVisible="{Binding Updates.HasUpdate}"
                   HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False" />
        </Grid>
        <ToggleButton Grid.Column="5" x:Name="ThemeButton" Theme="{StaticResource JournalThemeSwitch}"
                      IsChecked="{Binding IsDarkTheme, Mode=TwoWay}" VerticalAlignment="Center"
                      ToolTip.Tip="{Binding ThemeActionLabel}" AutomationProperties.Name="{Binding ThemeActionLabel}" />
        <ui:JournalButton Grid.Column="7" x:Name="PersonalizeButton" Label="Настроить экран" Icon="panels-top-left"
                          IconOnly="True" Width="32" Height="32" Padding="0" Click="OnCustomizeClick" IsEnabled="{Binding CanConfigureScreen}"
                          ToolTip.Tip="Настроить расположение панелей и столбцы" VerticalAlignment="Center" />
        <ui:JournalButton x:Name="DatabaseSettingsButton" Grid.Column="9" Label="База данных" Icon="settings-2" IsEnabled="{Binding CanConfigureSource}"
                          Click="OnDatabaseSettingsClick" ToolTip.Tip="Выбрать файл базы или демонстрационный журнал" VerticalAlignment="Center" />
      </Grid>
    </Border>
    <Border Grid.Row="1" IsVisible="{Binding IsCustomizing}" Background="{DynamicResource JournalAccentSoft}" Padding="24,6">
      <Grid ColumnDefinitions="*,12,Auto,8,Auto,8,Auto">
        <TextBlock Text="Перетащите блоки за захват · размеры — за разделители" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <ui:JournalButton x:Name="ResetLayoutButton" Grid.Column="2" Label="Сбросить к макету" Icon="rotate-ccw"
                          Click="OnResetLayoutClick" ToolTip.Tip="Показать стандартный экран. Отмена вернёт прежний" />
        <ui:JournalButton x:Name="CancelLayoutButton" Grid.Column="4" Label="Отмена" Icon="x"
                          Click="OnCancelLayoutClick" ToolTip.Tip="Вернуть прежнюю компоновку · Esc" />
        <ui:JournalButton x:Name="SaveLayoutButton" Grid.Column="6" Label="Готово" Icon="check" Classes="primary"
                          Click="OnSaveLayoutClick" ToolTip.Tip="Сохранить компоновку · Ctrl+Enter" />
      </Grid>
    </Border>
    <Border Grid.Row="2" IsVisible="{Binding HasPreferencesError}" Background="{DynamicResource JournalDangerBackground}" Padding="24,6">
      <Grid ColumnDefinitions="*,8,Auto">
        <TextBlock Text="{Binding PreferencesError}" Foreground="{DynamicResource JournalDangerForeground}" VerticalAlignment="Center" TextWrapping="Wrap" />
        <ui:JournalButton Grid.Column="2" Label="Закрыть сообщение" Icon="x" IconOnly="True" Width="32" Padding="0"
                          Click="OnDismissPreferencesError" ToolTip.Tip="Закрыть сообщение" />
      </Grid>
    </Border>
    <Grid x:Name="BodyGrid" Grid.Row="3" Margin="24,12,24,0" RowDefinitions="Auto,12,*">
      <Grid x:Name="TopArea" RowDefinitions="152,12,120">
        <Grid x:Name="ResultSlot">
          <Border x:Name="ResultPanel" Classes="panel" Padding="16,12,16,16">
            <Grid RowDefinitions="32,12,*">
              <Grid ColumnDefinitions="Auto,16,*,Auto,8,Auto,8,Auto">
                <TextBlock Text="Результат" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" IsVisible="{Binding !IsCustomizing}" />
                <ui:LayoutHandle x:Name="ResultMoveHandle" AutomationProperties.Name="Переместить панель: Результат" Title="Результат" PanelId="result" IsVisible="{Binding IsCustomizing}"
                                 ToolTip.Tip="Перетащите выше или ниже команд · ↑ ↓ с клавиатуры" />
                <TextBlock x:Name="ResultFeedback" Grid.Column="2" Text="{Binding ResultMessage}" Classes="muted result-feedback"
                           Classes.error="{Binding HasResultError}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding ResultMessage}" AutomationProperties.LiveSetting="Polite" />
                <ui:JournalButton x:Name="AddResultButton" Grid.Column="3" Label="Добавить выбранные" Icon="list-plus"
                                  Classes="outline" IsEnabled="{Binding CanAddResult}" Click="OnAddResultClick"
                                  ToolTip.Tip="Добавить выбранные заявки без повторов" />
                <ui:JournalButton x:Name="ClearResultButton" Grid.Column="5" Label="Очистить" Command="{Binding ClearResultCommand}"
                                  IsEnabled="{Binding CanClearResult}" ToolTip.Tip="Очистить результат, сохранив выбор заявок" />
                <ui:JournalButton x:Name="CopyResultButton" Grid.Column="7" Label="Копировать" Icon="clipboard-copy" Classes="primary"
                                  IsEnabled="{Binding CanCopyResult}" Click="OnCopyResultClick"
                                  ToolTip.Tip="Скопировать для письма: HTML, RTF и обычный текст" />
              </Grid>
              <TextBox x:Name="ResultTextBox" Grid.Row="2" Text="{Binding ResultText, Mode=TwoWay}" IsReadOnly="{Binding !CanEditResult}" AcceptsReturn="True"
                       TextWrapping="NoWrap" FontSize="14" Padding="16,10"
                       Background="{DynamicResource JournalRaised}" Foreground="{DynamicResource JournalText}"
                       BorderBrush="{DynamicResource JournalBorder}" CornerRadius="6"
                       PlaceholderText="Здесь будет текст результата для копирования в письмо"
                       ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                       AutomationProperties.Name="Результат для письма" />
            </Grid>
          </Border>
          <ui:LayoutHandle x:Name="ResultResizeHandle" PanelId="result-size" Classes="result-resizer" Height="8"
                           VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Focusable="True"
                           ToolTip.Tip="Изменить высоту результата · ↑ ↓ с клавиатуры"
                           AutomationProperties.Name="Изменить высоту результата" />
        </Grid>
        <Grid x:Name="CommandGroups" Grid.Row="2" ColumnDefinitions="380*,16,548*,16,592*">
          <Border x:Name="OrdersCommands" Classes="panel" Padding="16,10,16,12">
            <Grid RowDefinitions="18,8,32,8,32">
              <TextBlock Text="ЗАЯВКИ" Classes="muted" IsVisible="{Binding !IsCustomizing}" />
              <ui:LayoutHandle x:Name="OrdersMoveHandle" AutomationProperties.Name="Переместить панель: Заявки" Title="ЗАЯВКИ" PanelId="orders" IsVisible="{Binding IsCustomizing}"
                               ToolTip.Tip="Перетащите на другую группу · ← → с клавиатуры" />
              <Grid Grid.Row="2" ColumnDefinitions="1.18*,8,*">
                <ui:JournalButton x:Name="NewOrderButton" Label="Новая заявка" Icon="plus" Classes="primary"
                                  IsEnabled="{Binding CanCreateOrder}" Click="OnNewOrderClick"
                                  ToolTip.Tip="Добавить заявку в деможурнал текущего сеанса" />
                <ui:JournalButton x:Name="ReloadButton" Grid.Column="2" Label="Обновить" Icon="refresh-cw" Command="{Binding ReloadCommand}" />
              </Grid>
              <Grid Grid.Row="4" ColumnDefinitions="1.18*,8,*">
                <ui:JournalButton Label="Редактировать" Icon="pencil" IsEnabled="False" ToolTip.Tip="Функция пока не подключена" />
                <ui:JournalButton Grid.Column="2" Label="Удалить" Icon="trash" Classes="danger" IsEnabled="False" ToolTip.Tip="Функция пока не подключена" />
              </Grid>
            </Grid>
          </Border>
          <Border Grid.Column="2" x:Name="ClipboardCommands" Classes="panel" Padding="16,10,16,12">
            <Grid RowDefinitions="18,8,32,8,32">
              <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding !IsCustomizing}">
                <TextBlock Text="БУФЕР ОБМЕНА И БЛЦБ" Classes="muted" />
                <TextBlock Grid.Column="1" Text="{Binding SelectionText}" Classes="muted" Foreground="{DynamicResource JournalAccent}" />
              </Grid>
              <ui:LayoutHandle x:Name="ClipboardMoveHandle" AutomationProperties.Name="Переместить панель: Буфер обмена и БЛЦБ" Title="БУФЕР ОБМЕНА И БЛЦБ" PanelId="clipboard" IsVisible="{Binding IsCustomizing}"
                               ToolTip.Tip="Перетащите на другую группу · ← → с клавиатуры" />
              <Grid Grid.Row="2" ColumnDefinitions="*,8,1.18*">
                <ui:JournalButton x:Name="DeliveryNumberButton" Label="Добавить БЛЦБ" Icon="hash" IsEnabled="{Binding CanUpdateSelectedOrders}"
                                  Click="OnDeliveryNumberClick" ToolTip.Tip="Изменить номер БЛЦБ у выбранных заявок" />
                <ui:JournalButton Grid.Column="2" Label="Создать папки" Icon="folder-plus" IsEnabled="False" ToolTip.Tip="Функция пока не подключена" />
              </Grid>
              <Grid Grid.Row="4" ColumnDefinitions="*,8,1.18*">
                <ui:JournalButton Label="Комментарий строки" Icon="message-square" IsEnabled="False" ToolTip.Tip="Функция пока не подключена" />
                <ui:JournalButton Grid.Column="2" Label="Telegram комментарий" IsEnabled="False" ToolTip.Tip="Функция пока не подключена" />
              </Grid>
            </Grid>
          </Border>
          <Border Grid.Column="4" x:Name="StatusCommands" Classes="panel" Padding="16,10,16,12">
            <Grid RowDefinitions="18,8,32,8,32">
              <TextBlock Text="ПРИСВОИТЬ СТАТУС" Classes="muted" IsVisible="{Binding !IsCustomizing}" />
              <ui:LayoutHandle x:Name="StatusMoveHandle" AutomationProperties.Name="Переместить панель: Присвоить статус" Title="ПРИСВОИТЬ СТАТУС" PanelId="status" IsVisible="{Binding IsCustomizing}"
                               ToolTip.Tip="Перетащите на другую группу · ← → с клавиатуры" />
              <Grid Grid.Row="2" ColumnDefinitions="*,8,*,8,*">
                <ui:JournalButton x:Name="SetWorkButton" Grid.Column="0" Label="В работе" Classes="work"
                                  Command="{Binding SetOrderColorCommand}" CommandParameter="{x:Static orders:OrderColors.Work}"
                                  ToolTip.Tip="Присвоить статус выбранным заявкам" />
                <ui:JournalButton x:Name="SetReadyButton" Grid.Column="2" Label="Готово" Classes="ready"
                                  Command="{Binding SetOrderColorCommand}" CommandParameter="{x:Static orders:OrderColors.Ready}"
                                  ToolTip.Tip="Присвоить статус выбранным заявкам" />
                <ui:JournalButton x:Name="SetShippedButton" Grid.Column="4" Label="Отгружено" Classes="shipped"
                                  Command="{Binding SetOrderColorCommand}" CommandParameter="{x:Static orders:OrderColors.Shipped}"
                                  ToolTip.Tip="Присвоить статус выбранным заявкам" />
              </Grid>
              <Grid Grid.Row="4" ColumnDefinitions="1.4*,8,*,8,*">
                <ui:JournalButton Label="Другой цвет…" Icon="palette" Classes="outline" IsEnabled="False" ToolTip.Tip="Функция пока не подключена" />
                <ui:JournalButton x:Name="ClearColorButton" Grid.Column="2" Label="Снять цвет" Command="{Binding SetOrderColorCommand}"
                                  CommandParameter="{x:Static orders:OrderColors.None}" ToolTip.Tip="Убрать цветовую отметку у выбранных заявок" />
                <ui:JournalButton Grid.Column="4" Label="Код цвета" IsEnabled="False" ToolTip.Tip="Функция пока не подключена" />
              </Grid>
            </Grid>
          </Border>
          <GridSplitter x:Name="FirstPanelSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Center"
                        ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" IsVisible="{Binding IsCustomizing}"
                        Background="{DynamicResource JournalBorder}" KeyboardIncrement="8"
                        ToolTip.Tip="Изменить ширину панелей · ← → с клавиатуры" AutomationProperties.Name="Ширина левой панели" />
          <GridSplitter x:Name="SecondPanelSplitter" Grid.Column="3" Width="6" HorizontalAlignment="Center"
                        ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" IsVisible="{Binding IsCustomizing}"
                        Background="{DynamicResource JournalBorder}" KeyboardIncrement="8"
                        ToolTip.Tip="Изменить ширину панелей · ← → с клавиатуры" AutomationProperties.Name="Ширина правой панели" />
        </Grid>
      </Grid>
      <Grid x:Name="Workspace" Grid.Row="2" RowDefinitions="Auto,12,Auto,*,36">
        <Grid x:Name="FiltersPanel" Grid.Row="0" IsEnabled="{Binding CanUseJournal}" ColumnDefinitions="Auto,12,*">
          <StackPanel x:Name="StatusFilters" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="Показать" Classes="muted" VerticalAlignment="Center" Margin="0,0,8,0" />
            <RadioButton Classes="filter" GroupName="Status" Content="Все" IsChecked="{Binding FilterAll, Mode=OneWay}"
                         Command="{Binding SetStatusFilterCommand}" CommandParameter="{x:Static vm:OrderStatusFilter.All}" />
            <RadioButton Classes="filter" GroupName="Status" Content="В работе" IsChecked="{Binding FilterWork, Mode=OneWay}"
                         Command="{Binding SetStatusFilterCommand}" CommandParameter="{x:Static vm:OrderStatusFilter.Work}" />
            <RadioButton Classes="filter" GroupName="Status" Content="Готово" IsChecked="{Binding FilterReady, Mode=OneWay}"
                         Command="{Binding SetStatusFilterCommand}" CommandParameter="{x:Static vm:OrderStatusFilter.Ready}" />
            <RadioButton Classes="filter" GroupName="Status" Content="Отгружено" IsChecked="{Binding FilterShipped, Mode=OneWay}"
                         Command="{Binding SetStatusFilterCommand}" CommandParameter="{x:Static vm:OrderStatusFilter.Shipped}" />
            <Border Width="1" Height="24" Background="{DynamicResource JournalBorder}" Margin="4,0" />
            <ui:JournalButton Label="Сегодня" Command="{Binding TodayCommand}" />
            <ui:JournalDatePicker x:Name="DateFilter" SelectedDate="{Binding FilterDate}" PlaceholderText="Дата: любая" Width="160" MinHeight="32"
                                AutomationProperties.Name="Дата заявки" />
          </StackPanel>
          <Grid x:Name="SearchControls" Grid.Column="2" ColumnDefinitions="132,8,*,8,Auto" VerticalAlignment="Center">
            <ComboBox ItemsSource="{Binding SearchScopes}" SelectedIndex="{Binding SearchScopeIndex}" HorizontalAlignment="Stretch"
                      AutomationProperties.Name="Поле поиска" MinHeight="36" />
            <TextBox x:Name="SearchBox" Grid.Column="2" Text="{Binding SearchText}" MinHeight="36" MinWidth="160"
                     PlaceholderText="Поиск по номеру, заказчику, БЛЦБ…" AutomationProperties.Name="Поиск заявок">
              <TextBox.KeyBindings><KeyBinding Gesture="Escape" Command="{Binding ClearSearchCommand}" /></TextBox.KeyBindings>
            </TextBox>
            <ui:JournalButton Grid.Column="4" Label="Сбросить" Icon="x" Command="{Binding ResetFiltersCommand}" />
          </Grid>
        </Grid>
        <Border x:Name="LoadErrorPanel" Grid.Row="2" IsVisible="{Binding HasError}" Background="{DynamicResource JournalDangerBackground}" CornerRadius="6" Padding="12" Margin="0,0,0,12">
          <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource JournalDangerForeground}" TextWrapping="Wrap" />
        </Border>
        <Border x:Name="TablePanel" Grid.Row="3" Classes="panel" ClipToBounds="True">
          <Grid>
            <DataGrid x:Name="OrdersGrid" IsEnabled="{Binding CanInteractWithTable}" ItemsSource="{Binding Orders}" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Extended" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                      RowHeight="32" ColumnHeaderHeight="44" FontSize="13" BorderThickness="0"
                      CanUserResizeColumns="True" CanUserReorderColumns="True" CanUserSortColumns="{Binding CanUseJournal}"
                      FrozenColumnCount="1"
                      SelectionChanged="OnSelectionChanged" CurrentCellChanged="OnCurrentCellChanged"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
              <DataGrid.Columns>
                <DataGridTemplateColumn Width="80" MinWidth="80" MaxWidth="80" CanUserSort="False"
                                        CanUserReorder="False" CanUserResize="False">
                  <DataGridTemplateColumn.Header>
                    <Grid ColumnDefinitions="32,8,24" Width="64">
                      <ui:JournalButton x:Name="ColumnsButton" Label="Столбцы" Icon="columns-3" IconOnly="True"
                                        Width="32" Height="32" Padding="0" ToolTip.Tip="Показать или скрыть столбцы">
                        <Button.Flyout>
                          <Flyout>
                            <StackPanel Spacing="12" Width="300">
                              <TextBlock Text="Видимые столбцы" FontSize="16" FontWeight="SemiBold" />
                              <Grid ColumnDefinitions="*,8,*">
                                <ui:JournalButton x:Name="ShowAllColumnsButton" Label="Показать все" Click="OnShowAllColumns" />
                                <ui:JournalButton x:Name="HideAllColumnsButton" Grid.Column="2" Label="Скрыть все" Click="OnHideAllColumns" />
                              </Grid>
                              <ScrollViewer MaxHeight="360"><StackPanel x:Name="ColumnChoices" Spacing="4" /></ScrollViewer>
                            </StackPanel>
                          </Flyout>
                        </Button.Flyout>
                      </ui:JournalButton>
                      <CheckBox Grid.Column="2" x:Name="SelectAllRowsBox" MinHeight="32" HorizontalAlignment="Center"
                                IsEnabled="{Binding CanSelectOrders}" Click="OnSelectAllRows"
                                ToolTip.Tip="Выбрать все заявки в текущем списке / снять выбор"
                                AutomationProperties.Name="Выбрать все заявки в текущем списке или снять выбор" />
                    </Grid>
                  </DataGridTemplateColumn.Header>
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:OrderRowViewModel">
                      <Grid ColumnDefinitions="32,8,24" Width="64">
                        <CheckBox Grid.Column="2" IsEnabled="{ReflectionBinding DataContext.CanUseJournal, RelativeSource={RelativeSource AncestorType=Window}}" Classes="row-selection" HorizontalAlignment="Center" MinHeight="32"
                                  IsChecked="{Binding $parent[DataGridRow].IsSelected, Mode=TwoWay}"
                                  AutomationProperties.Name="{Binding SpecificationNumber, StringFormat='Выбрать заявку {0}'}" />
                      </Grid>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Дата" Binding="{ReflectionBinding DateText}" SortMemberPath="OrderDate" Width="96" MinWidth="96" />
                <DataGridTextColumn Header="Спецификация" Binding="{ReflectionBinding SpecificationNumber}" Width="120" MinWidth="112" />
                <DataGridTextColumn Header="Менеджер" Binding="{ReflectionBinding ManagerName}" Width="130" MinWidth="100" />
                <DataGridTextColumn Header="Заказчик" Binding="{ReflectionBinding CustomerName}" Width="*" MinWidth="180" />
                <DataGridTextColumn Header="Вид резки" Binding="{ReflectionBinding CuttingType}" Width="130" MinWidth="106" />
                <DataGridTextColumn Header="Материал" Binding="{ReflectionBinding MaterialName}" Width="94" MinWidth="80" />
                <DataGridTextColumn Header="Толщ., мм" Binding="{ReflectionBinding ThicknessText}" SortMemberPath="ThicknessMillimeters" Width="68" MinWidth="68" />
                <DataGridTextColumn Header="Размер листа" Binding="{ReflectionBinding SheetSize}" Width="112" MinWidth="106" />
                <DataGridTextColumn Header="Листы" Binding="{ReflectionBinding SheetCount}" Width="60" MinWidth="60" />
                <DataGridTextColumn Header="Рез, м" Binding="{ReflectionBinding CutLengthText}" SortMemberPath="CutLengthMeters" Width="76" MinWidth="64" />
                <DataGridTextColumn Header="Вес, кг" Binding="{ReflectionBinding WeightText}" Width="74" MinWidth="68" />
                <DataGridTextColumn Header="Стоимость" Binding="{ReflectionBinding StoredPriceText}" SortMemberPath="StoredCuttingPrice" Width="112" MinWidth="112" />
                <DataGridTextColumn Header="БЛЦБ" Binding="{ReflectionBinding DeliveryNumber}" Width="144" MinWidth="128" />
                <DataGridTemplateColumn Header="Статус" Width="128" MinWidth="128" SortMemberPath="StatusText">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:OrderRowViewModel">
                      <Grid ColumnDefinitions="3,*">
                        <Border Background="{Binding ColorMark}" Margin="0,4" />
                        <ui:StatusBadge Grid.Column="1" Status="{Binding StatusKey}" Text="{Binding StatusText}" />
                      </Grid>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
            <StackPanel x:Name="EmptyState" IsEnabled="{Binding CanUseJournal}" IsVisible="{Binding ShowEmptyState}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
              <TextBlock Text="Заявки не найдены" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" />
              <TextBlock Text="Измените поиск или сбросьте фильтры" Classes="muted" />
              <ui:JournalButton Label="Сбросить фильтры" Command="{Binding ResetFiltersCommand}" HorizontalAlignment="Center" />
            </StackPanel>
            <Border x:Name="LoadingState" IsVisible="{Binding IsLoadingOrders}" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource JournalRaised}" BorderBrush="{DynamicResource JournalBorder}" BorderThickness="1" CornerRadius="6" Padding="20,16">
              <StackPanel Spacing="12">
                <TextBlock Text="Загрузка заявок…" HorizontalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                <ProgressBar IsIndeterminate="True" Width="180" Height="4" />
              </StackPanel>
            </Border>
          </Grid>
        </Border>
        <Grid Grid.Row="4" ColumnDefinitions="Auto,24,Auto,24,*" VerticalAlignment="Center">
          <TextBlock Text="{Binding CountText}" Classes="muted" />
          <TextBlock Grid.Column="2" Text="{Binding ActiveOrderText}" Classes="muted" Foreground="{DynamicResource JournalAccent}" />
          <TextBlock Grid.Column="4" Text="Shift / Ctrl — выбор строк" Classes="muted" TextTrimming="CharacterEllipsis" />
        </Grid>
      </Grid>
    </Grid>
    <Grid Grid.Row="4" Margin="24,0" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
      <TextBlock Text="{Binding UpdatedText}" Classes="muted" TextTrimming="CharacterEllipsis" />
      <TextBlock Grid.Column="1" Text="{Binding SourceDescription}" Classes="muted" />
    </Grid>
    <Canvas x:Name="LayoutOverlay" Grid.RowSpan="5" IsHitTestVisible="False" ClipToBounds="True">
      <Border x:Name="DropGuide" IsVisible="False" Height="3" CornerRadius="2" Background="{DynamicResource JournalAccent}" />
      <Border x:Name="DragPreview" IsVisible="False" Padding="12,8" CornerRadius="6"
              Background="{DynamicResource JournalAccent}" Opacity="0.94">
        <TextBlock x:Name="DragPreviewText" Foreground="{DynamicResource JournalOnAccent}" />
      </Border>
    </Canvas>
  </Grid>
</Window>
