<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Jornal.Desktop.ViewModels" xmlns:ui="using:Jornal.Desktop.Controls"
        x:Class="Jornal.Desktop.Views.NewOrderWindow" x:DataType="vm:NewOrderViewModel"
        Title="{Binding WindowTitle}" Width="1240" Height="760" MinWidth="1060" MinHeight="600"
        WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBox.invalid">
      <Setter Property="BorderBrush" Value="{DynamicResource JournalDangerForeground}" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource JournalSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource JournalAccent}" />
    </Style>
    <Style Selector="TextBox.invalid:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{DynamicResource JournalDangerForeground}" />
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Background="{DynamicResource JournalSurface}" BorderBrush="{DynamicResource JournalBorder}"
            BorderThickness="0,0,0,1" Padding="24,12">
      <StackPanel Spacing="4">
        <TextBlock Text="Новая заявка" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="{Binding StorageDescription}" Classes="muted" TextWrapping="Wrap" />
        <TextBlock x:Name="ImportAttention" Text="Есть замечания к разбору. Проверьте поля и пояснения справа."
                   IsVisible="{Binding HasImportDiagnostics}" TextWrapping="Wrap" Foreground="{DynamicResource JournalDangerForeground}" />
      </StackPanel>
    </Border>
    <Grid Grid.Row="1" Margin="24,12" ColumnDefinitions="*,24,260">
      <Border Classes="panel">
        <ScrollViewer x:Name="FormScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="FormFields" Margin="16" Spacing="5" IsEnabled="{Binding !IsBusy}">
            <TextBlock Text="Заявка и заказчик" Classes="section" />
            <Grid ColumnDefinitions="*,24,*">
              <ui:OrderEntryControl DataContext="{Binding OrderDate}" />
              <ui:OrderEntryControl Grid.Column="2" DataContext="{Binding SpecificationNumber}" />
            </Grid>
            <Grid ColumnDefinitions="*,24,*">
              <ui:OrderEntryControl DataContext="{Binding Manager}" />
              <ui:OrderEntryControl Grid.Column="2" DataContext="{Binding Customer}" />
            </Grid>
            <TextBlock Text="Параметры резки" Classes="section" Margin="0,4,0,0" />
            <Grid ColumnDefinitions="*,24,*">
              <ui:OrderEntryControl DataContext="{Binding CuttingType}" />
              <ui:OrderEntryControl Grid.Column="2" DataContext="{Binding Material}" />
            </Grid>
            <Grid ColumnDefinitions="*,24,*">
              <ui:OrderEntryControl DataContext="{Binding Thickness}" />
              <ui:OrderEntryControl Grid.Column="2" DataContext="{Binding SheetSize}" />
            </Grid>
            <Grid ColumnDefinitions="*,24,*">
              <ui:OrderEntryControl DataContext="{Binding SheetCount}" />
              <ui:OrderEntryControl Grid.Column="2" DataContext="{Binding Weight}" />
            </Grid>
            <Grid ColumnDefinitions="*,24,*">
              <ui:OrderEntryControl DataContext="{Binding CutLength}" />
              <ui:OrderEntryControl Grid.Column="2" DataContext="{Binding Coefficient}" />
            </Grid>
            <Grid ColumnDefinitions="*,24,*">
              <ui:OrderEntryControl x:Name="CuttingTimeInput" DataContext="{Binding CuttingTime}"
                                    ToolTip.Tip="Часы и минуты. Например, 29:46 или 342:51. Пусто — время неизвестно." />
              <TextBlock Grid.Column="2" Text="Часы могут превышать 24. Секунды из спецификации округляются вверх до минуты."
                         Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12" />
            </Grid>
            <Grid ColumnDefinitions="*,24,*" IsVisible="{Binding IsHansLaser}">
              <ui:OrderEntryControl DataContext="{Binding MaterialId}" />
              <ui:OrderEntryControl Grid.Column="2" DataContext="{Binding Gas}" />
            </Grid>
            <TextBlock Text="* Обязательные поля. Дробные значения можно вводить через запятую или точку."
                       Classes="muted" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </Border>
      <Border Grid.Column="2" Classes="panel" Padding="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="12">
          <TextBlock Text="Стоимость" Classes="section" />
          <TextBlock Text="{Binding PriceText}" FontSize="18" FontWeight="Medium" />
          <TextBlock Text="{Binding PriceBreakdown}" Classes="muted" TextWrapping="Wrap" />
          <TextBlock Text="{Binding PriceDescription}" Classes="muted" TextWrapping="Wrap" />
          <ui:JournalButton x:Name="CalculatePriceButton" Label="Рассчитать" Icon="refresh-cw" IsVisible="{Binding HasPricing}"
                            Command="{Binding CalculatePriceCommand}" />
          <TextBlock Text="{Binding PriceError}" IsVisible="{Binding HasPriceError}"
                     Foreground="{DynamicResource JournalDangerForeground}" TextWrapping="Wrap" />
          <Border Height="1" Background="{DynamicResource JournalBorder}" Margin="0,8" />
          <TextBlock Text="Из спецификации" Classes="section" />
          <TextBlock Text="Выберите HTML БЛОК/Wintech или PDF HansLaser. Файл можно перетащить на главное окно. Проверьте поля перед добавлением."
                     Classes="muted" TextWrapping="Wrap" />
          <ui:JournalButton x:Name="BrowseSpecificationButton" Label="Выбрать спецификацию" Classes="outline" IsEnabled="{Binding !IsBusy}"
                            Click="OnBrowseSpecification" ToolTip.Tip="Прочитать спецификацию без записи в журнал" />
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsImporting}" Height="4" />
          <ui:JournalButton Label="Отменить чтение" Click="OnCancelFormImport" IsVisible="{Binding IsImporting}" />
          <Border IsVisible="{Binding HasPendingImport}" Background="{DynamicResource JournalAccentSoft}" Padding="12" CornerRadius="6">
            <StackPanel Spacing="10">
              <TextBlock Text="Заменить параметры спецификации? Менеджер и заказчик сохранятся." TextWrapping="Wrap" />
              <TextBlock Text="{Binding PendingImportName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PendingImportName}" />
              <ui:JournalButton Label="Заменить параметры" Command="{Binding ReplaceImportCommand}" />
              <ui:JournalButton Label="Оставить прежние" Command="{Binding CancelImportReplacementCommand}" />
            </StackPanel>
          </Border>
          <TextBlock Text="{Binding ImportError}" IsVisible="{Binding HasImportError}" TextWrapping="Wrap" Foreground="{DynamicResource JournalDangerForeground}" />
          <StackPanel IsVisible="{Binding HasImport}" Spacing="8">
            <TextBlock x:Name="ImportFileName" Text="{Binding ImportPreview.FileName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ImportPreview.FileName}" FontWeight="Medium" />
            <TextBlock Text="{Binding ImportPreview.Counts}" Classes="muted" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ImportPreview.Duration}" Classes="muted" TextWrapping="Wrap" />
            <TextBlock Text="Время можно исправить в поле слева. Секунды округляются вверх до полной минуты." Classes="muted" TextWrapping="Wrap" FontSize="12" />
            <TextBlock Text="{Binding ImportPreview.Diagnostics}" IsVisible="{Binding HasImportDiagnostics}" TextWrapping="Wrap"
                       Foreground="{DynamicResource JournalDangerForeground}" />
            <TextBlock Text="Пустые поля заполните вручную. Источник значения доступен в подсказке под полем." Classes="muted" TextWrapping="Wrap" />
          </StackPanel>
          <ui:JournalButton Label="Вставить текст" Classes="outline" IsEnabled="False"
                            ToolTip.Tip="Импорт текста из буфера будет добавлен отдельно" />
        </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
    <Border Grid.Row="2" Background="{DynamicResource JournalSurface}" BorderBrush="{DynamicResource JournalBorder}"
            BorderThickness="0,1,0,0" Padding="24,12">
      <Grid ColumnDefinitions="*,24,Auto" RowDefinitions="Auto,Auto">
        <StackPanel VerticalAlignment="Center" Spacing="4">
          <TextBlock Text="{Binding SaveDescription}" Classes="muted" TextWrapping="Wrap" />
          <TextBlock x:Name="ValidationSummary" Text="Проверьте отмеченные поля. Ввод сохранён."
                     IsVisible="{Binding HasValidationErrors}" Foreground="{DynamicResource JournalDangerForeground}" />
          <TextBlock Text="{Binding SaveError}" IsVisible="{Binding HasSaveError}"
                     Foreground="{DynamicResource JournalDangerForeground}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <ui:JournalButton x:Name="CancelButton" Label="Отмена" Classes="outline" MinHeight="38"
                            Click="OnCancelClick" IsEnabled="{Binding !SaveCommand.IsRunning}" />
          <ui:JournalButton x:Name="SaveButton" Label="{Binding SaveLabel}" Classes="primary" MinHeight="38"
                            Command="{Binding SaveCommand}" Click="OnSaveClick" IsDefault="True" />
        </StackPanel>
        <ui:WindowsSecurityHelp x:Name="OrderSecurityHelp" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0"
                                DataContext="{Binding AccessHostHelp}" />
      </Grid>
    </Border>
  </Grid>
</Window>
