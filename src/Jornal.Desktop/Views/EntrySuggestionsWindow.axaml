<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Jornal.Desktop.ViewModels" xmlns:ui="using:Jornal.Desktop.Controls"
        x:Class="Jornal.Desktop.Views.EntrySuggestionsWindow" x:DataType="vm:EntrySuggestionsViewModel"
        Title="Менеджеры и заказчики" Width="800" Height="560" MinWidth="640" MinHeight="440" WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,Auto">
    <StackPanel Margin="24,20,24,16" Spacing="8">
      <TextBlock Text="Менеджеры и заказчики" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="Одно значение на строку" Classes="muted" />
    </StackPanel>
    <Grid Grid.Row="1" ColumnDefinitions="*,16,*" Margin="24,0">
      <Grid RowDefinitions="Auto,8,*">
        <TextBlock Text="Менеджеры" FontWeight="SemiBold" />
        <TextBox x:Name="ManagersInput" Grid.Row="2" Text="{Binding ManagersText, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" MaxLength="16000" AutomationProperties.Name="Список менеджеров" />
      </Grid>
      <Grid Grid.Column="2" RowDefinitions="Auto,8,*">
        <TextBlock Text="Заказчики" FontWeight="SemiBold" />
        <TextBox x:Name="CustomersInput" Grid.Row="2" Text="{Binding CustomersText, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" MaxLength="16000" AutomationProperties.Name="Список заказчиков" />
      </Grid>
    </Grid>
    <Border Grid.Row="2" Padding="24,16" Margin="0,16,0,0" Background="{DynamicResource JournalSurface}">
      <StackPanel Spacing="12">
        <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="{DynamicResource JournalDangerForeground}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <ui:JournalButton x:Name="SaveSuggestionsButton" Label="Сохранить" Classes="primary" Command="{Binding SaveCommand}" />
          <ui:JournalButton Label="Отмена" Click="OnCancelClick" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
