<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Jornal.Desktop.ViewModels" xmlns:ui="using:Jornal.Desktop.Controls"
        x:Class="Jornal.Desktop.Views.MachineImportWindow" x:DataType="vm:MachineImportViewModel"
        Title="Настройка станка" Width="540" Height="460" MinWidth="460" MinHeight="420" WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="*,Auto">
    <ScrollViewer Margin="24,20" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="12">
      <TextBlock Text="Настройка станка" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="Название" FontWeight="Medium" />
      <TextBox x:Name="MachineDisplayNameInput" Text="{Binding Name, Mode=TwoWay}" MaxLength="255" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Название станка" />
      <TextBlock Text="Импорт спецификаций" FontWeight="Medium" />
      <ComboBox x:Name="MachineImportProfileInput" ItemsSource="{Binding Profiles}" SelectedItem="{Binding Profile, Mode=TwoWay}"
                HorizontalAlignment="Stretch" IsEnabled="{Binding CanChangeImport}" AutomationProperties.Name="Импорт спецификаций">
        <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:MachineProfileChoice"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock Text="Расчёт" FontWeight="Medium" />
      <TextBlock Text="{Binding CalculationText}" Classes="muted" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" TextWrapping="Wrap" Foreground="{DynamicResource JournalDangerForeground}" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="1" Padding="24,14" Background="{DynamicResource JournalSurface}">
      <StackPanel Spacing="10">
        <Grid IsVisible="{Binding ConfirmDiscard}" ColumnDefinitions="*,Auto,8,Auto">
          <TextBlock Text="Закрыть без сохранения?" VerticalAlignment="Center" TextWrapping="Wrap" />
          <ui:JournalButton Grid.Column="1" Label="Продолжить" Click="OnKeepEditingClick" />
          <ui:JournalButton Grid.Column="3" Label="Не сохранять" Click="OnDiscardClick" />
        </Grid>
        <Grid ColumnDefinitions="*,Auto,8,Auto">
          <ui:JournalButton Label="Обновить" Icon="refresh-cw" Command="{Binding ReloadCommand}" IsVisible="{Binding RequiresReload}" HorizontalAlignment="Left" />
          <ui:JournalButton Grid.Column="1" x:Name="SaveMachineImportButton" Label="Сохранить" Icon="check" Classes="primary" Command="{Binding SaveCommand}" />
          <ui:JournalButton Grid.Column="3" Label="Отмена" Click="OnCancelClick" IsEnabled="{Binding !IsSaving}" />
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</Window>
