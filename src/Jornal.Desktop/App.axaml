<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Jornal.Desktop.App"
             RequestedThemeVariant="Light">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Jornal.Desktop/Themes/Palette.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <FontFamily x:Key="JournalFont">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <!-- Тот же акцент, что и JournalAccent в Palette.axaml: для нативных чекбоксов и фокуса. -->
        <ColorPaletteResources x:Key="Light" Accent="#42668F" />
        <ColorPaletteResources x:Key="Dark" Accent="#99B5D3" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <StyleInclude Source="avares://Jornal.Desktop/Themes/Journal.axaml" />
  </Application.Styles>
</Application>
